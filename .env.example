# MongoDB Atlas — Database > Connect > Drivers
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="scentnest"

# Sign JWTs. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES="7d"

# Store owner's WhatsApp number in international format, no + or spaces
SHOP_WHATSAPP="8801XXXXXXXXX"

# SSLCommerz hosted checkout. Use sandbox credentials while testing.
SSLCOMMERZ_STORE_ID="your-store-id"
SSLCOMMERZ_STORE_PASSWORD="your-store-password"
SSLCOMMERZ_SANDBOX="true"
APP_URL="https://your-site.netlify.app"
SHOP_EMAIL="nestscent@gmail.com"

# Flat delivery charges in BDT
SHIPPING_DHAKA="60"
SHIPPING_OUTSIDE="120"
